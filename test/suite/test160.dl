// Quicksort: in-place sort via Lomuto partition scheme (1-indexed)
var swap := func(arr, i, j) is
    var tmp := arr[i]
    arr[i] := arr[j]
    arr[j] := tmp
end

var partition := func(arr, lo, hi) is
    var pivot := arr[hi]
    var i := lo - 1
    var k := lo
    while k <= hi - 1 loop
        if arr[k] <= pivot then
            i := i + 1
            swap(arr, i, k)
        end
        k := k + 1
    end
    swap(arr, i + 1, hi)
    return i + 1
end

var qsort := func(arr, lo, hi) is
    if lo < hi then
        var p := partition(arr, lo, hi)
        qsort(arr, lo, p - 1)
        qsort(arr, p + 1, hi)
    end
end

var arr := [3, 6, 8, 10, 1, 2, 1]
qsort(arr, 1, 7)
print arr[1], arr[2], arr[3], arr[4], arr[5], arr[6], arr[7]
