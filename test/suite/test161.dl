// Binary search on a sorted array (1-indexed)
var bsearch := func(arr, target, lo, hi) is
    while lo <= hi loop
        var mid := (lo + hi) / 2
        if arr[mid] = target then
            return mid
        end
        if arr[mid] < target then
            lo := mid + 1
        else
            hi := mid - 1
        end
    end
    return -1
end

var sorted := [1, 3, 5, 7, 9, 11, 13]
print bsearch(sorted, 7, 1, 7)
print bsearch(sorted, 1, 1, 7)
print bsearch(sorted, 13, 1, 7)
print bsearch(sorted, 6, 1, 7)
